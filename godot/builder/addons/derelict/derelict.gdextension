[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.3
reloadable = true

[libraries]
windows.debug.x86_64 = "res://addons/derelict/bin/win64/derelict_godot.dll"
windows.release.x86_64 = "res://addons/derelict/bin/win64/derelict_godot.dll"
linux.debug.x86_64 = "res://addons/derelict/bin/linux64/libderelict_godot.so"
linux.release.x86_64 = "res://addons/derelict/bin/linux64/libderelict_godot.so"
macos.debug = "res://addons/derelict/bin/macos/libderelict_godot.dylib"
macos.release = "res://addons/derelict/bin/macos/libderelict_godot.dylib"
